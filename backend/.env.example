# Supabase Postgres connection details. Never commit real credentials.
# Use the Session Pooler host (Project Settings -> Database -> Connect),
# not the direct db.<ref>.supabase.co host, which is IPv6-only.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=your-password
